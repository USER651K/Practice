READ TABLE lt_afru INTO DATA(ls_afru_dt)
         WITH KEY rmzhl = ls_afwd-rmzhl.
    IF sy-subrc = 0.
      DATA: lv_date(10) TYPE c,
            lv_time(8)  TYPE c.
      WRITE ls_afru_dt-ersda TO lv_date DD/MM/YYYY.
      WRITE ls_afru_dt-erzet TO lv_time USING EDIT MASK '__:__:__'.
      CONCATENATE 'Confirmed on' lv_date 'at' lv_time 'hrs'
             INTO gv_conf_date SEPARATED BY space.
    ENDIF.










CLEAR gv_conf_date.
    LOOP AT lt_afru INTO DATA(ls_afru_dt).
      IF ls_afru_dt-rmzhl = ls_afwd-rmzhl.
        DATA: lv_date(10) TYPE c,
              lv_time(8)  TYPE c.
        WRITE ls_afru_dt-ersda TO lv_date DD/MM/YYYY.
        WRITE ls_afru_dt-erzet TO lv_time USING EDIT MASK '__:__:__'.
        CONCATENATE 'Confirmed on' lv_date 'at' lv_time 'hrs'
               INTO gv_conf_date SEPARATED BY space.
        EXIT.
      ENDIF.
    ENDLOOP.
















***BOC--UJWAL--18.08.2026
    ELSE.
*     Component dimension is not MASS (e.g. BAG, EA in dimension AAAADL)
*     Cross-dimension conversion to MT is not possible via MD_CONVERT_MATERIAL_UNIT.
*     Base qty stays in component UOM; MT derived from material net weight.
      gs_alv-qty_base = gs_stpo-menge.

      IF ls_t006_cmp-dimid = 'MASS'.
*       Component UOM itself is mass-based -> direct convert to MT
        CLEAR lv_out_mt.
        CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
          EXPORTING
            i_matnr              = gs_stpo-idnrk
            i_in_me              = gs_stpo-meins
            i_out_me             = 'MT'
            i_menge              = gs_stpo-menge
          IMPORTING
            e_menge              = lv_out_mt
          EXCEPTIONS
            error_in_application = 1
            error                = 2
            OTHERS               = 3.
        IF sy-subrc = 0.
          gs_alv-qty_mt = lv_out_mt.
        ENDIF.

      ELSE.
*       Non-mass component UOM -> bridge to MT via MARA net weight
        CLEAR ls_mara_wt.
        READ TABLE gt_mara_wt INTO ls_mara_wt
             WITH KEY matnr = gs_stpo-idnrk
             BINARY SEARCH.
        IF sy-subrc = 0 AND ls_mara_wt-ntgew IS NOT INITIAL
                        AND ls_mara_wt-gewei IS NOT INITIAL.
          CLEAR lv_wt.
          lv_wt = gs_stpo-menge * ls_mara_wt-ntgew.

          CLEAR lv_out_mt.
          CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
            EXPORTING
              i_matnr              = gs_stpo-idnrk
              i_in_me              = ls_mara_wt-gewei
              i_out_me             = 'MT'
              i_menge              = lv_wt
            IMPORTING
              e_menge              = lv_out_mt
            EXCEPTIONS
              error_in_application = 1
              error                = 2
              OTHERS               = 3.
          IF sy-subrc = 0.
            gs_alv-qty_mt = lv_out_mt.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
***EOC--UJWAL--18.08.2026










***BOC--UJWAL--18.08.2026
* In top include / TYPES section:
* TYPES: BEGIN OF ty_mara_wt,
*          matnr TYPE mara-matnr,
*          ntgew TYPE mara-ntgew,
*          gewei TYPE mara-gewei,
*        END OF ty_mara_wt.
* DATA:  gt_mara_wt TYPE STANDARD TABLE OF ty_mara_wt.

DATA: ls_mara_wt TYPE ty_mara_wt,
      lv_wt      TYPE menge_d.
***EOC--UJWAL--18.08.2026










***BOC--UJWAL--18.08.2026
  IF lt_idnrk IS NOT INITIAL.
    SELECT matnr ntgew gewei
      FROM mara
      INTO TABLE gt_mara_wt
      FOR ALL ENTRIES IN lt_idnrk
      WHERE matnr = lt_idnrk-table_line.
    SORT gt_mara_wt BY matnr.
  ENDIF.
***EOC--UJWAL--18.08.2026









***BOC--UJWAL--18.08.2026
    ELSE.
*     Component dimension is not MASS (e.g. BAG/EA in dimension AAAADL).
*     Cross-dimension conversion to MT via MD_CONVERT_MATERIAL_UNIT is not
*     possible, so base qty stays in component UOM and MT is derived below.
      gs_alv-qty_base = gs_stpo-menge.

      IF ls_t006_cmp-dimid = 'MASS'.
*       Component UOM is mass-based -> direct convert to MT
        CLEAR lv_out_mt.
        CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
          EXPORTING
            i_matnr              = gs_stpo-idnrk
            i_in_me              = gs_stpo-meins
            i_out_me             = 'MT'
            i_menge              = gs_stpo-menge
          IMPORTING
            e_menge              = lv_out_mt
          EXCEPTIONS
            error_in_application = 1
            error                = 2
            OTHERS               = 3.
        IF sy-subrc = 0.
          gs_alv-qty_mt = lv_out_mt.
        ENDIF.

      ELSE.
*       Non-mass component UOM -> bridge to MT via MARA net weight
        READ TABLE gt_mara_uom INTO ls_mara_uom
             WITH KEY matnr = gs_stpo-idnrk
             BINARY SEARCH.
        IF sy-subrc = 0 AND ls_mara_uom-ntgew IS NOT INITIAL
                        AND ls_mara_uom-gewei IS NOT INITIAL.
          CLEAR lv_wt.
          lv_wt = gs_stpo-menge * ls_mara_uom-ntgew.

          CLEAR lv_out_mt.
          CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
            EXPORTING
              i_matnr              = gs_stpo-idnrk
              i_in_me              = ls_mara_uom-gewei
              i_out_me             = 'MT'
              i_menge              = lv_wt
            IMPORTING
              e_menge              = lv_out_mt
            EXCEPTIONS
              error_in_application = 1
              error                = 2
              OTHERS               = 3.
          IF sy-subrc = 0.
            gs_alv-qty_mt = lv_out_mt.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
***EOC--UJWAL--18.08.2026












***BOC--UJWAL--18.08.2026
    IF ls_t006_cmp-dimid = 'MASS' AND ls_t006_bas-dimid = 'MASS'.
*     Case 3: both mass-based -> base and MT via direct conversion
*     (your existing MASS/MASS base + MT conversion block stays here)
      ... keep your original MASS-AND-MASS conversions unchanged ...

    ELSE.
*     Component / base not both MASS. Base qty stays in component UOM.
      gs_alv-qty_base = gs_stpo-menge.

*     Try direct conversion to MT first.
*     Succeeds if component UOM is mass-based (Case 3 on component side)
*     OR a mass-unit conversion (LB/MT/KG) is maintained in MARM (Case 1).
      CLEAR lv_out_mt.
      CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
        EXPORTING
          i_matnr              = gs_stpo-idnrk
          i_in_me              = gs_stpo-meins
          i_out_me             = 'MT'
          i_menge              = gs_stpo-menge
        IMPORTING
          e_menge              = lv_out_mt
        EXCEPTIONS
          error_in_application = 1
          error                = 2
          OTHERS               = 3.
      IF sy-subrc = 0.
*       Case 1 / Case 3 satisfied via direct or maintained conversion
        gs_alv-qty_mt = lv_out_mt.
      ELSE.
*       Case 2: no maintained mass conversion -> bridge via MARA net weight
        READ TABLE gt_mara_uom INTO ls_mara_uom
             WITH KEY matnr = gs_stpo-idnrk
             BINARY SEARCH.
        IF sy-subrc = 0 AND ls_mara_uom-ntgew IS NOT INITIAL
                        AND ls_mara_uom-gewei IS NOT INITIAL.
          CLEAR lv_wt.
          TRY.
              lv_wt = gs_stpo-menge * ls_mara_uom-ntgew.
            CATCH cx_sy_arithmetic_overflow.
              CLEAR lv_wt.
          ENDTRY.

          IF lv_wt IS NOT INITIAL.
            CLEAR lv_out_mt.
            CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
              EXPORTING
                i_matnr              = gs_stpo-idnrk
                i_in_me              = ls_mara_uom-gewei
                i_out_me             = 'MT'
                i_menge              = lv_wt
              IMPORTING
                e_menge              = lv_out_mt
              EXCEPTIONS
                error_in_application = 1
                error                = 2
                OTHERS               = 3.
            IF sy-subrc = 0.
              gs_alv-qty_mt = lv_out_mt.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
***EOC--UJWAL--18.08.2026

    APPEND gs_alv TO gt_alv.











***BOC--UJWAL--18.08.2026
TYPES: BEGIN OF ty_mara_uom,
         matnr TYPE mara-matnr,
         ntgew TYPE mara-ntgew,
         gewei TYPE mara-gewei,
       END OF ty_mara_uom.
DATA:  gt_mara_uom TYPE STANDARD TABLE OF ty_mara_uom,
       ls_mara_uom TYPE ty_mara_uom,
       lv_wt       TYPE p LENGTH 16 DECIMALS 3.
***EOC--UJWAL--18.08.2026






***BOC--UJWAL--18.08.2026
  SELECT matnr ntgew gewei
    FROM mara
    INTO TABLE gt_mara_uom
    FOR ALL ENTRIES IN gt_mast
    WHERE matnr = gt_mast-matnr.
  SORT gt_mara_uom BY matnr.
***EOC--UJWAL--18.08.2026








  CLEAR: gs_alv-qty_mt, lv_out_menge.

  IF gs_stko-bmein = 'MT'.
    gs_alv-qty_mt = gs_stko-bmeng.
  ELSE.
    READ TABLE gt_t006 INTO ls_t006_uom
         WITH KEY msehi = gs_stko-bmein
         BINARY SEARCH.

    IF sy-subrc = 0 AND ls_t006_uom-dimid = 'MASS'.
*     Case 3: unit is already a mass unit - direct convert
      CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
        EXPORTING
          i_matnr = gs_mast-matnr
          i_in_me = gs_stko-bmein
          i_out_me = 'MT'
          i_menge  = gs_stko-bmeng
        IMPORTING
          e_menge  = lv_out_menge
        EXCEPTIONS
          error_in_application = 1
          error                = 2
          OTHERS               = 3.
      IF sy-subrc = 0.
        gs_alv-qty_mt = lv_out_menge.
      ENDIF.

***BOC--UJWAL--18.08.2026
    ELSE.
*     Case 1: non-mass unit, but a mass conversion may be maintained in MARM
      CLEAR lv_out_menge.
      CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
        EXPORTING
          i_matnr = gs_mast-matnr
          i_in_me = gs_stko-bmein
          i_out_me = 'MT'
          i_menge  = gs_stko-bmeng
        IMPORTING
          e_menge  = lv_out_menge
        EXCEPTIONS
          error_in_application = 1
          error                = 2
          OTHERS               = 3.
      IF sy-subrc = 0.
        gs_alv-qty_mt = lv_out_menge.
      ELSE.
*       Case 2: no conversion maintained - fall back to MARA net weight
        READ TABLE gt_mara_uom INTO ls_mara_uom
             WITH KEY matnr = gs_mast-matnr
             BINARY SEARCH.
        IF sy-subrc = 0 AND ls_mara_uom-ntgew IS NOT INITIAL
                        AND ls_mara_uom-gewei IS NOT INITIAL.
          CLEAR lv_wt.
          TRY.
              lv_wt = gs_stko-bmeng * ls_mara_uom-ntgew.
            CATCH cx_sy_arithmetic_overflow.
              CLEAR lv_wt.
          ENDTRY.

          IF lv_wt IS NOT INITIAL.
            CLEAR lv_out_menge.
            CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
              EXPORTING
                i_matnr = gs_mast-matnr
                i_in_me = ls_mara_uom-gewei
                i_out_me = 'MT'
                i_menge  = lv_wt
              IMPORTING
                e_menge  = lv_out_menge
              EXCEPTIONS
                error_in_application = 1
                error                = 2
                OTHERS               = 3.
            IF sy-subrc = 0.
              gs_alv-qty_mt = lv_out_menge.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
***EOC--UJWAL--18.08.2026
    ENDIF.
  ENDIF.

  APPEND gs_alv TO gt_alv.











        IF lv_wt IS NOT INITIAL.
          CLEAR lv_out_menge.
          CALL FUNCTION 'UNIT_CONVERSION_SIMPLE'
            EXPORTING
              input                = lv_wt
              unit_in              = ls_mara_uom-gewei
              unit_out             = 'MT'
            IMPORTING
              output               = lv_out_menge
            EXCEPTIONS
              conversion_not_found = 1
              division_by_zero     = 2
              input_invalid        = 3
              output_invalid       = 4
              overflow             = 5
              type_invalid         = 6
              units_missing        = 7
              unit_in_not_found    = 8
              unit_out_not_found   = 9
              OTHERS               = 10.
          IF sy-subrc = 0.
            gs_alv-qty_mt = lv_out_menge.
          ENDIF.
        ENDIF.







  AT SELECTION-SCREEN.
***BOC--UJWAL--20.08.2026
    IF lines( s_gstrs[] ) <> 1.
      MESSAGE 'Please enter exactly one date range (Basic Start Date)' TYPE 'E'.
    ENDIF.
    IF s_gstrs-low IS INITIAL OR s_gstrs-high IS INITIAL.
      MESSAGE 'Both From date and To date are mandatory' TYPE 'E'.
    ENDIF.
    IF s_gstrs-low > s_gstrs-high.
      MESSAGE 'From date must not be later than To date' TYPE 'E'.
    ENDIF.
