         dmdis      TYPE zperc,
         brokn      TYPE zperc,
         lengt      TYPE zperc,
         breth      TYPE zperc,
         bas        TYPE zperc,
         z1509mix   TYPE zperc,
         basdup     TYPE zperc,
         z1121pus   TYPE zperc,
         shab       TYPE zperc,
         parm       TYPE zperc,
         suga       TYPE zperc,
         oth        TYPE zperc,
         totadmix   TYPE zperc,
         kett       TYPE zperc,
         moisture   TYPE zperc,
         sela       TYPE zperc,
         paddyper   TYPE zperc,
         sltd       TYPE zperc,
         z1121admx  TYPE zperc,
         z1509admx  TYPE zperc,
         pusaadmx   TYPE zperc,
         sugadmix   TYPE zperc,
         paddywhr   TYPE zperc,
         bkn25      TYPE zperc,
         greengr    TYPE zperc,
         chalkygr   TYPE zperc,
         ddgr       TYPE zperc,
         immgr      TYPE zperc,
         deadgr     TYPE zperc,
         purity     TYPE zperc,
         z1718mix   TYPE zperc,
         z1401mix   TYPE zperc,
         rh10mix    TYPE zperc,
         sharmix    TYPE zperc,
         paddy      TYPE zperc,
         bknwht     TYPE zperc,
         whitedd    TYPE zperc,
         sella      TYPE zperc,
         cook       TYPE char40,
         z1718admx  TYPE zperc,
         rh10admx   TYPE zperc,
         sbtiadmx   TYPE zperc,
         pusamix    TYPE zperc,
         sellamix   TYPE zperc,
         belly      TYPE zperc,
         branst     TYPE zperc,
         kett1      TYPE zperc,
         ricmoist   TYPE zperc,
         wv         TYPE zperc,
         ckod       TYPE char40,
         apc        TYPE char40,
         total_ex   TYPE zperc,
         ktextlos   TYPE qals-ktextlos,
         gv_status  TYPE char30,
         del_num    TYPE char12,
         y          TYPE zperc,
         z          TYPE zperc,
         lengrad    TYPE c LENGTH 1,
         infst      TYPE char40,
         aroma      TYPE char40,
         fm         TYPE char40,
         pes        TYPE char40,
         co2        TYPE char40,
         cln        TYPE char40,
         brka01     TYPE zperc,
         brka02     TYPE zperc,
         brka03     TYPE zperc,
         brka04     TYPE zperc,
         brka05     TYPE zperc,
         brka06     TYPE zperc,
         brka07     TYPE zperc,
         brka08     TYPE zperc,
         brka09     TYPE zperc,
         brka10     TYPE zperc,
         brka11     TYPE zperc,
         brka12     TYPE zperc,
         brka13     TYPE zperc,
         zgrad01    TYPE char40,
         comp01     TYPE zperc,
         taj1       TYPE zperc,
         rh10mix1   TYPE zperc,
         sm1        TYPE zperc,
         ot1        TYPE zperc,
         z1509mix1  TYPE zperc,
         rej_reason TYPE string,
         sel        TYPE c,
         choba      TYPE zperc,
         rec_cpudt  TYPE sydatum,
         rec_cputm  TYPE syuzeit,
         vdatum     TYPE sydatum,
         vezeiterf  TYPE syuzeit,
