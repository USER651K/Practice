
EXPORT git_final FROM git_final TO MEMORY ID 'ZO9ZLABCOM'.








*&---------------------------------------------------------------------*
*&  Include  ZO9_ZLABCOM_TOP
*&---------------------------------------------------------------------*

TABLES: qals, mch1, t001w.

TYPES: BEGIN OF ty_final_mirror,
         matnr      TYPE matnr,
         art        TYPE qals-art,
         ktextmat   TYPE qkurztext,
         charg      TYPE charg_d,
         enstehdat  TYPE qentst,
         mblnr      TYPE mblnr,
         ebeln      TYPE ebeln,
         ebelp      TYPE ebelp,
         werk       TYPE werks_d,
         sellifnr   TYPE elifn,
         losmenge   TYPE qlosmenge,
         lgpla      TYPE lgpla,
         lagortvorg TYPE qlgortvorg,
         name1      TYPE lfa1-name1,
         prueflos   TYPE qplos,
         mandi      TYPE zp2pdemandi,
         truck      TYPE zp2pdetruck,
         geno       TYPE zp2pdegeno,
         bag        TYPE zp2pbag,
         unldngsup  TYPE char20,
         price      TYPE dmbtr,
         pperq      TYPE netwr,
         lpperqp    TYPE netwr,
         psbnm      TYPE zperc,
         psugh      TYPE zperc,
         psrbt      TYPE zperc,
         admix      TYPE zperc,
         pparm      TYPE zperc,
         mbd        TYPE zperc,
         mad        TYPE zperc,
