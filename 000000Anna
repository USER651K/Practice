  SELECT prueflos INTO lv_dup_lot FROM qals UP TO 1 ROWS
    WHERE charg    = <lv_charg>
      AND herkunft = '89'
      AND prueflos NE <lv_curlot>
    ORDER BY PRIMARY KEY.
