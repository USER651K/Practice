METHOD if_ex_inspectionlot_update~change_at_save.
" BA_3767 - Duplicate batch check on QA02 save
  DATA: lv_dup_lot TYPE qals-prueflos.

" (read i_qals / the import param - confirm exact name from Parameters tab)
  IF <import_qals>-charg IS NOT INITIAL.
    SELECT prueflos INTO lv_dup_lot FROM qals UP TO 1 ROWS
      WHERE charg    = <import_qals>-charg
        AND herkunft = '89'
        AND prueflos NE <import_qals>-prueflos
      ORDER BY PRIMARY KEY.
    ENDSELECT.
    IF sy-subrc = 0.
"     raise exception / message to block save - confirm mechanism
      MESSAGE e398(00) WITH 'Entered Batch' <import_qals>-charg
                            'is already assigned to Lot' lv_dup_lot.
    ENDIF.
  ENDIF.
ENDMETHOD.








METHOD if_ex_inspectionlot_update~change_at_save.
*  BA_3767 - Duplicate batch check on QA02 save

  DATA: lv_dup_lot TYPE qals-prueflos.

* Only validate if a batch is entered AND it was actually changed
* (FS rule 2: unchanged batch -> allow; changed batch -> re-check)
  IF new_insplot-charg IS NOT INITIAL
    AND new_insplot-charg NE old_insplot-charg.

*   Is the new batch already on another origin-89 lot?
    SELECT prueflos INTO lv_dup_lot FROM qals UP TO 1 ROWS
      WHERE charg    = new_insplot-charg
        AND herkunft = '89'
        AND prueflos NE new_insplot-prueflos
      ORDER BY PRIMARY KEY.
    ENDSELECT.

    IF sy-subrc = 0.
      MESSAGE e398(00) WITH 'Entered Batch' new_insplot-charg
                            'is already assigned to Lot' lv_dup_lot
                       RAISING error_with_message.
    ENDIF.

  ENDIF.

ENDMETHOD.








METHOD if_ex_inspectionlot_update~create_at_save.
*  BA_3767 - Duplicate batch HARD BLOCK on QA01 save (creation)

  DATA: lv_dup_lot TYPE qals-prueflos.

  IF new_insplot-charg IS NOT INITIAL.

*   Creation: any existing origin-89 lot with this batch is a duplicate.
    SELECT prueflos INTO lv_dup_lot FROM qals UP TO 1 ROWS
      WHERE charg    = new_insplot-charg
        AND herkunft = '89'
      ORDER BY PRIMARY KEY.
    ENDSELECT.

    IF sy-subrc = 0.
      MESSAGE e398(00) WITH 'Entered Batch' new_insplot-charg
                            'is already assigned to Lot' lv_dup_lot
                       RAISING error_with_message.
    ENDIF.

  ENDIF.

ENDMETHOD.
