       BEGIN OF ty_lips,
         vbeln TYPE lips-vbeln,
         posnr TYPE lips-posnr,
         matnr TYPE lips-matnr,
         arktx TYPE lips-arktx,
         lfimg TYPE lips-lfimg,
         vrkme TYPE lips-vrkme,
*BOC--Ujwal--20.05.2026.
         ntgew TYPE lips-ntgew,
         gewei TYPE lips-gewei,
*EOC--Ujwal--20.05.2026.
*BOC--UJWAL--30.10.2026 Sales unit conversion factors
         umvkz TYPE lips-umvkz,
         umvkn TYPE lips-umvkn,
*EOC--UJWAL--30.10.2026
       END OF ty_lips,






*BOC-------UJWAL---
      TYPES: BEGIN OF ty_vfkn,
        fknum TYPE vfkn-fknum,
        rebel TYPE vfkn-rebel,
        repos TYPE vfkn-repos,          "Ref. item - UJWAL 30.10.2026
        netwr TYPE vfkn-netwr,
      END OF ty_vfkn.
*EOC-------UJWAL---






*BOC--UJWAL--30.10.2026 Batch split sub-items
TYPES: BEGIN OF ty_lips_sub,
         vbeln TYPE lips-vbeln,
         posnr TYPE lips-posnr,
         uecha TYPE lips-uecha,
         matnr TYPE lips-matnr,
         lfimg TYPE lips-lfimg,
         vrkme TYPE lips-vrkme,
         lgmng TYPE lips-lgmng,
         ntgew TYPE lips-ntgew,
         gewei TYPE lips-gewei,
       END OF ty_lips_sub.
DATA: gt_lips_sub TYPE SORTED TABLE OF ty_lips_sub
                  WITH NON-UNIQUE KEY vbeln uecha posnr.
*EOC--UJWAL--30.10.2026




  IF lr_vbeln_deliv IS NOT INITIAL.
    SELECT vbeln, posnr, matnr, arktx, lfimg, vrkme, ntgew, gewei,
           umvkz, umvkn                                   "UJWAL 30.10.2026
      FROM lips
      INTO TABLE @gt_lips
      FOR ALL ENTRIES IN @gt_vbfa_j
      WHERE vbeln = @gt_vbfa_j-vbeln
      AND posnr = @gt_vbfa_j-posnn.
  ENDIF.




*BOC--UJWAL--30.10.2026  Batch split sub-items (UECHA = main item)
  IF gt_lips IS NOT INITIAL.
    SELECT vbeln, posnr, uecha, matnr, lfimg, vrkme, lgmng, ntgew, gewei
      FROM lips
      FOR ALL ENTRIES IN @gt_lips
      WHERE vbeln = @gt_lips-vbeln
        AND uecha = @gt_lips-posnr
      INTO TABLE @gt_lips_sub.
  ENDIF.
*EOC--UJWAL--30.10.2026



*BOC--UJWAL----------
    SELECT fknum rebel repos netwr                       "repos added UJWAL 30.10.2026
      FROM vfkn
      INTO TABLE gt_vfkn
     " WHERE rebel IN lr_vbeln_contract.
      WHERE rebel IN lr_vbeln_deliv.
*EOC--UJWAL----------






*BOC--UJWAL--30.10.2026
  DATA: ls_lips_sub   TYPE ty_lips_sub,
        lv_sub_lgmng  TYPE lips-lgmng,
        lv_sub_lfimg  TYPE lips-lfimg,
        lv_sub_ntgew  TYPE lips-ntgew,
        lv_has_sub    TYPE abap_bool,
        lv_vfkn_hdr   TYPE vfkn-netwr,
        lv_vfkn_doc   TYPE vfkn-fknum,
        lv_vfkn_split TYPE abap_bool.
*EOC--UJWAL--30.10.2026



*BOC--UJWAL--30.10.2026  Batch split: qty & weight from sub-items
          CLEAR: lv_sub_lgmng, lv_sub_lfimg, lv_sub_ntgew, lv_has_sub.
          LOOP AT gt_lips_sub INTO ls_lips_sub
               WHERE vbeln = ls_lips-vbeln
                 AND uecha = ls_lips-posnr.
            CHECK ls_lips_sub-matnr = ls_lips-matnr.   "only batches of same material
            lv_has_sub   = abap_true.
            lv_sub_lgmng = lv_sub_lgmng + ls_lips_sub-lgmng.          "base unit
            IF ls_lips_sub-vrkme = ls_lips-vrkme.
              lv_sub_lfimg = lv_sub_lfimg + ls_lips_sub-lfimg.        "fallback
            ENDIF.
            CASE ls_lips_sub-gewei.                                   "weight in KG
              WHEN 'TO' OR 'TNE'.
                lv_sub_ntgew = lv_sub_ntgew + ls_lips_sub-ntgew * 1000.
              WHEN 'G'.
                lv_sub_ntgew = lv_sub_ntgew + ls_lips_sub-ntgew / 1000.
              WHEN OTHERS.
                lv_sub_ntgew = lv_sub_ntgew + ls_lips_sub-ntgew.
            ENDCASE.
          ENDLOOP.

          IF lv_has_sub = abap_true.
            IF ls_lips-umvkz IS NOT INITIAL.
*             Sales unit qty = base qty * UMVKN / UMVKZ
              ls_lips-lfimg = lv_sub_lgmng * ls_lips-umvkn / ls_lips-umvkz.
            ELSE.
              ls_lips-lfimg = lv_sub_lfimg.
            ENDIF.
            ls_lips-ntgew = lv_sub_ntgew.
            ls_lips-gewei = 'KG'.
          ENDIF.
*EOC--UJWAL--30.10.2026







*BOC--UJWAL--30.10.2026  Shipment cost (VFKN) per delivery ITEM
        CLEAR: lv_vfkn_hdr, lv_vfkn_doc, lv_vfkn_split.
        LOOP AT gt_vfkn INTO ls_vfkn WHERE rebel = ls_vbfa_j-vbeln.
          IF ls_vfkn-repos = ls_vbfa_j-posnn.
*           Cost line for this item
            gs_output-shipment_freight = gs_output-shipment_freight + ls_vfkn-netwr.
            gs_output-ship_cost_doc    = ls_vfkn-fknum.
          ELSEIF ls_vfkn-repos IS INITIAL.
*           Cost line at delivery header level -> split by value later
            lv_vfkn_hdr = lv_vfkn_hdr + ls_vfkn-netwr.
            lv_vfkn_doc = ls_vfkn-fknum.
          ELSE.
*           Cost line on a batch sub-item of this item
            READ TABLE gt_lips_sub TRANSPORTING NO FIELDS
                 WITH KEY vbeln = ls_vfkn-rebel
                          uecha = ls_vbfa_j-posnn
                          posnr = ls_vfkn-repos.
            IF sy-subrc = 0.
              gs_output-shipment_freight = gs_output-shipment_freight + ls_vfkn-netwr.
              gs_output-ship_cost_doc    = ls_vfkn-fknum.
            ENDIF.
          ENDIF.
        ENDLOOP.
        IF gs_output-shipment_freight IS INITIAL AND lv_vfkn_hdr IS NOT INITIAL.
          gs_output-shipment_freight = lv_vfkn_hdr.
          gs_output-ship_cost_doc    = lv_vfkn_doc.
          lv_vfkn_split              = abap_true.
        ENDIF.
*EOC--UJWAL--30.10.2026








            IF lv_del_sales > 0.
              gs_output-ship_cost_frt = lv_del_frt_alloc * ls_vbrp-netwr / lv_del_sales.
*BOC--UJWAL--30.10.2026  VFKN is item level; split only header-level cost
              IF lv_vfkn_split = abap_true.
                gs_output-shipment_freight = lv_del_frt_vfkn * ls_vbrp-netwr / lv_del_sales.
              ENDIF.
*EOC--UJWAL--30.10.2026
            ENDIF.
































BEGIN OF ty_prcd,
         knumv TYPE prcd_elements-knumv,
         kposn TYPE prcd_elements-kposn,          "Added UJWAL 28.10.2026
         kschl TYPE prcd_elements-kschl,
         kbetr TYPE prcd_elements-kbetr,
         kwert type prcd_elements-kwert,
       END OF ty_prcd,






         plan_frt_var      TYPE p LENGTH 15 DECIMALS 2, "Planned Freight Variance
*BOC--UJWAL--28.10.2026  Technical keys (not displayed in ALV)
         deliv_item        TYPE lips-posnr,              "Delivery item
         bill_item         TYPE vbrp-posnr,              "Billing item
*EOC--UJWAL--28.10.2026
       END OF ty_output.






*BOC--UJWAL--28.10.2026 Invoice item net values
TYPES: BEGIN OF ty_vbrp,
         vbeln TYPE vbrp-vbeln,
         posnr TYPE vbrp-posnr,
         netwr TYPE vbrp-netwr,
       END OF ty_vbrp.
DATA: gt_vbrp TYPE SORTED TABLE OF ty_vbrp WITH UNIQUE KEY vbeln posnr.
*EOC--UJWAL--28.10.2026







    SELECT knumv kposn kschl kbetr kwert          "kposn added UJWAL 28.10.2026
      FROM prcd_elements
      INTO TABLE gt_prcd
      WHERE knumv IN lr_knumv
        AND kschl IN ( ...unchanged... ).







*BOC--UJWAL--28.10.2026
    SELECT vbeln, posnr, netwr
      FROM vbrp
      WHERE vbeln IN @lr_vbeln_billing
      INTO TABLE @gt_vbrp.
*EOC--UJWAL--28.10.2026
  ENDIF.







*BOC--UJWAL--28.10.2026
*--- Billing Document No. (Delivery to Billing) - Handle BOTH M and U types
*--- One row per delivery item per billing document, item-level values
      DATA: lt_del_billing     TYPE STANDARD TABLE OF ty_vbfa,
            ls_del_bill        TYPE ty_vbfa,
            ls_vbrk_bill       TYPE ty_vbrk,
            ls_vbrp            TYPE ty_vbrp,
            lv_del_sales       TYPE vbrp-netwr,
            lv_del_frt_alloc   TYPE vttk-tndr_maxp,
            lv_del_frt_vfkn    TYPE vfkp-netwr,
            lv_actual_freight  TYPE p DECIMALS 2.

      CLEAR: lt_del_billing, ls_del_bill, ls_vbrk_bill.

*--- Delivery-level freight & delivery sales value (base for item split)
      CLEAR: lv_del_sales, lv_del_frt_alloc, lv_del_frt_vfkn, ls_del.
      lv_del_frt_alloc = gs_output-ship_cost_frt.       "TNDR_MAXP share of delivery
      lv_del_frt_vfkn  = gs_output-shipment_freight.    "VFKN amount of delivery
      IF gs_output-tknum IS NOT INITIAL.
        READ TABLE gt_del_sales INTO ls_del
             WITH TABLE KEY tknum = gs_output-tknum
                            vbeln = ls_vbfa_j-vbeln.
        IF sy-subrc = 0.
          lv_del_sales = ls_del-netwr.
        ENDIF.
      ENDIF.

*--- Collect all billing docs (M and U) for this delivery item
      LOOP AT gt_vbfa_del_m INTO ls_del_bill
        WHERE vbelv = ls_vbfa_j-vbeln
          AND posnv = ls_vbfa_j-posnn.
        APPEND ls_del_bill TO lt_del_billing.
      ENDLOOP.

      IF lt_del_billing IS INITIAL.
*--- No billing exists - row is removed later (billing_doc initial)
        CLEAR: gs_output-billing_doc, gs_output-invoice_date, gs_output-bill_item.
        gs_output-deliv_item = ls_vbfa_j-posnn.                        "NEW
        APPEND gs_output TO gt_output.
      ELSE.
*--- One row per billing document
        LOOP AT lt_del_billing INTO ls_del_bill.
          CLEAR: gs_output-billing_doc, gs_output-invoice_date.
          gs_output-deliv_item = ls_vbfa_j-posnn.                      "NEW
          gs_output-bill_item  = ls_del_bill-posnn.                    "NEW

          "BOC SA 19/06/26
          READ TABLE lt_chk INTO DATA(ls_chk) WITH KEY
          vbeln = ls_del_bill-vbeln.
          IF sy-subrc = 0.
            gs_output-billing_doc = ls_del_bill-vbeln.
          ENDIF.
          "EOC SA 19/06/26

*--- Clear invoice-level values; reset freight to delivery level
          CLEAR: gs_output-sales_price, gs_output-stwae, gs_output-inco,
                 gs_output-cpg, gs_output-planned_freight, gs_output-cogs,
                 ls_vbrk_bill, ls_vbrp.
          gs_output-ship_cost_frt    = lv_del_frt_alloc.
          gs_output-shipment_freight = lv_del_frt_vfkn.

          READ TABLE gt_vbrk INTO ls_vbrk_bill
            WITH KEY vbeln = ls_del_bill-vbeln.
          IF sy-subrc = 0.
            gs_output-invoice_date = ls_vbrk_bill-fkdat.
            gs_output-stwae        = ls_vbrk_bill-stwae.
            gs_output-inco         = ls_vbrk_bill-inco1.

*--- Sales price = this invoice item's net value
            READ TABLE gt_vbrp INTO ls_vbrp
                 WITH TABLE KEY vbeln = ls_del_bill-vbeln
                                posnr = ls_del_bill-posnn.
            gs_output-sales_price = ls_vbrp-netwr.

*--- COGS / Planned freight / CPG = this invoice item's conditions
            LOOP AT gt_prcd INTO ls_prcd
                 WHERE knumv = ls_vbrk_bill-knumv
                   AND kposn = ls_del_bill-posnn.
              CASE ls_prcd-kschl.
                WHEN 'ZFRT'.
                  gs_output-planned_freight = gs_output-planned_freight + ls_prcd-kwert.
                WHEN 'VPRS'.
                  gs_output-cogs = gs_output-cogs + ls_prcd-kwert.
                WHEN OTHERS.
                  gs_output-cpg = gs_output-cpg + ls_prcd-kwert.
              ENDCASE.
            ENDLOOP.

*--- Split delivery freight to this item by value share
            IF lv_del_sales > 0.
              gs_output-ship_cost_frt    = lv_del_frt_alloc * ls_vbrp-netwr / lv_del_sales.
              gs_output-shipment_freight = lv_del_frt_vfkn  * ls_vbrp-netwr / lv_del_sales.
            ENDIF.
          ENDIF.

*--- Calculations per row
          CLEAR: lv_actual_freight, gs_output-net_contribution,
                 gs_output-percent_net, gs_output-plan_frt_var.
*         Actual freight = Shipment cost doc (VFKN), else allocated TNDR_MAXP
          IF gs_output-shipment_freight IS NOT INITIAL.
            lv_actual_freight = gs_output-shipment_freight.
          ELSE.
            lv_actual_freight = gs_output-ship_cost_frt.
          ENDIF.
*         Net Contribution = Sales Price - (Actual Freight + COGS + CPG)
          gs_output-net_contribution = gs_output-sales_price
                                     - ( lv_actual_freight + gs_output-cogs + gs_output-cpg ).
          IF gs_output-sales_price IS NOT INITIAL.
            gs_output-percent_net = ( gs_output-net_contribution / gs_output-sales_price ) * 100.
          ENDIF.
*         Planned Freight Variance = Planned Freight - Actual Freight
          gs_output-plan_frt_var = gs_output-planned_freight - lv_actual_freight.

          APPEND gs_output TO gt_output.
        ENDLOOP.
      ENDIF.
*EOC--UJWAL--28.10.2026






















BEGIN OF ty_prcd,
         knumv TYPE prcd_elements-knumv,
         kposn TYPE prcd_elements-kposn,          "Added UJWAL 28.10.2026
         kschl TYPE prcd_elements-kschl,
         kbetr TYPE prcd_elements-kbetr,
         kwert type prcd_elements-kwert,
       END OF ty_prcd,




*BOC--UJWAL--28.10.2026 Invoice item net values
TYPES: BEGIN OF ty_vbrp,
         vbeln TYPE vbrp-vbeln,
         posnr TYPE vbrp-posnr,
         netwr TYPE vbrp-netwr,
       END OF ty_vbrp.
DATA: gt_vbrp TYPE SORTED TABLE OF ty_vbrp WITH UNIQUE KEY vbeln posnr.
*EOC--UJWAL--28.10.2026




  IF lr_knumv IS NOT INITIAL.
    SELECT knumv kposn kschl kbetr kwert          "kposn added UJWAL 28.10.2026
      FROM prcd_elements





*BOC--UJWAL--28.10.2026
    SELECT vbeln, posnr, netwr
      FROM vbrp
      WHERE vbeln IN @lr_vbeln_billing
      INTO TABLE @gt_vbrp.
*EOC--UJWAL--28.10.2026
  ENDIF.





*BOC--UJWAL--28.10.2026
*--- Billing Document No. (Delivery to Billing) - Handle BOTH M and U types
*--- One row per delivery item per billing document, item-level values
      DATA: lt_del_billing     TYPE STANDARD TABLE OF ty_vbfa,
            ls_del_bill        TYPE ty_vbfa,
            ls_vbrk_bill       TYPE ty_vbrk,
            ls_vbrp            TYPE ty_vbrp,
            lv_del_sales       TYPE vbrp-netwr,
            lv_del_frt_alloc   TYPE vttk-tndr_maxp,
            lv_del_frt_vfkn    TYPE vfkp-netwr,
            lv_actual_freight  TYPE p DECIMALS 2.

      CLEAR: lt_del_billing, ls_del_bill, ls_vbrk_bill.

*--- Delivery-level freight & delivery sales value (base for item split)
      CLEAR: lv_del_sales, lv_del_frt_alloc, lv_del_frt_vfkn, ls_del.
      lv_del_frt_alloc = gs_output-ship_cost_frt.       "TNDR_MAXP share of delivery
      lv_del_frt_vfkn  = gs_output-shipment_freight.    "VFKN amount of delivery
      IF gs_output-tknum IS NOT INITIAL.
        READ TABLE gt_del_sales INTO ls_del
             WITH TABLE KEY tknum = gs_output-tknum
                            vbeln = ls_vbfa_j-vbeln.
        IF sy-subrc = 0.
          lv_del_sales = ls_del-netwr.
        ENDIF.
      ENDIF.

*--- Collect all billing docs (M and U) for this delivery item
      LOOP AT gt_vbfa_del_m INTO ls_del_bill
        WHERE vbelv = ls_vbfa_j-vbeln
          AND posnv = ls_vbfa_j-posnn.
        APPEND ls_del_bill TO lt_del_billing.
      ENDLOOP.

      IF lt_del_billing IS INITIAL.
*--- No billing exists - row is removed later (billing_doc initial)
        CLEAR: gs_output-billing_doc, gs_output-invoice_date.
        APPEND gs_output TO gt_output.
      ELSE.
*--- One row per billing document
        LOOP AT lt_del_billing INTO ls_del_bill.
          CLEAR: gs_output-billing_doc, gs_output-invoice_date.

          "BOC SA 19/06/26
          READ TABLE lt_chk INTO DATA(ls_chk) WITH KEY
          vbeln = ls_del_bill-vbeln.
          IF sy-subrc = 0.
            gs_output-billing_doc = ls_del_bill-vbeln.
          ENDIF.
          "EOC SA 19/06/26

*--- Clear invoice-level values; reset freight to delivery level
          CLEAR: gs_output-sales_price, gs_output-stwae, gs_output-inco,
                 gs_output-cpg, gs_output-planned_freight, gs_output-cogs,
                 ls_vbrk_bill, ls_vbrp.
          gs_output-ship_cost_frt    = lv_del_frt_alloc.
          gs_output-shipment_freight = lv_del_frt_vfkn.

          READ TABLE gt_vbrk INTO ls_vbrk_bill
            WITH KEY vbeln = ls_del_bill-vbeln.
          IF sy-subrc = 0.
            gs_output-invoice_date = ls_vbrk_bill-fkdat.
            gs_output-stwae        = ls_vbrk_bill-stwae.
            gs_output-inco         = ls_vbrk_bill-inco1.

*--- Sales price = this invoice item's net value
            READ TABLE gt_vbrp INTO ls_vbrp
                 WITH TABLE KEY vbeln = ls_del_bill-vbeln
                                posnr = ls_del_bill-posnn.
            gs_output-sales_price = ls_vbrp-netwr.

*--- COGS / Planned freight / CPG = this invoice item's conditions
            LOOP AT gt_prcd INTO ls_prcd
                 WHERE knumv = ls_vbrk_bill-knumv
                   AND kposn = ls_del_bill-posnn.
              CASE ls_prcd-kschl.
                WHEN 'ZFRT'.
                  gs_output-planned_freight = gs_output-planned_freight + ls_prcd-kwert.
                WHEN 'VPRS'.
                  gs_output-cogs = gs_output-cogs + ls_prcd-kwert.
                WHEN OTHERS.
                  gs_output-cpg = gs_output-cpg + ls_prcd-kwert.
              ENDCASE.
            ENDLOOP.

*--- Split delivery freight to this item by value share
            IF lv_del_sales > 0.
              gs_output-ship_cost_frt    = lv_del_frt_alloc * ls_vbrp-netwr / lv_del_sales.
              gs_output-shipment_freight = lv_del_frt_vfkn  * ls_vbrp-netwr / lv_del_sales.
            ENDIF.
          ENDIF.

*--- Calculations per row
          CLEAR: lv_actual_freight, gs_output-net_contribution,
                 gs_output-percent_net, gs_output-plan_frt_var.
*         Actual freight = Shipment cost doc (VFKN), else allocated TNDR_MAXP
          IF gs_output-shipment_freight IS NOT INITIAL.
            lv_actual_freight = gs_output-shipment_freight.
          ELSE.
            lv_actual_freight = gs_output-ship_cost_frt.
          ENDIF.
*         Net Contribution = Sales Price - (Actual Freight + COGS + CPG)
          gs_output-net_contribution = gs_output-sales_price
                                     - ( lv_actual_freight + gs_output-cogs + gs_output-cpg ).
          IF gs_output-sales_price IS NOT INITIAL.
            gs_output-percent_net = ( gs_output-net_contribution / gs_output-sales_price ) * 100.
          ENDIF.
*         Planned Freight Variance = Planned Freight - Actual Freight
          gs_output-plan_frt_var = gs_output-planned_freight - lv_actual_freight.

          APPEND gs_output TO gt_output.
        ENDLOOP.
      ENDIF.
*EOC--UJWAL--28.10.2026

















TYPES: BEGIN OF ty_who,
         who TYPE /scwm/ordim_o-who,
       END OF ty_who.

DATA: gt_who     TYPE STANDARD TABLE OF ty_who,
      gs_who     TYPE ty_who,
      gt_ordim_o TYPE /scwm/tt_ordim_o,
      gt_ordim_c TYPE /scwm/tt_ordim_c.



  PARAMETERS: p_lgnum TYPE /scwm/lgnum OBLIGATORY DEFAULT '3U01',
              p_who   TYPE /scwm/ordim_o-who OBLIGATORY.





FORM get_warehouse_orders.

  DATA lv_who TYPE /scwm/ordim_o-who.

  CLEAR gt_who.

* Open tasks
  SELECT SINGLE who FROM /scwm/ordim_o
    INTO lv_who
    WHERE lgnum = p_lgnum
      AND who   = p_who.
  IF sy-subrc <> 0.
*   Confirmed tasks (reprint after confirmation)
    SELECT SINGLE who FROM /scwm/ordim_c
      INTO lv_who
      WHERE lgnum = p_lgnum
        AND who   = p_who.
  ENDIF.

  IF sy-subrc = 0.
    gs_who-who = p_who.
    APPEND gs_who TO gt_who.
  ENDIF.

ENDFORM.








netid TYPE char1,
    sortf TYPE char10,
    ewahr TYPE char13,
    alpst TYPE char2,
    alprf TYPE char3,
    alpgr TYPE char4,
  END OF ty_data.




INITIALIZATION.
  sscrfields-functxt_01 = 'Download Format'.

AT SELECTION-SCREEN.
  IF sscrfields-ucomm = 'FC01'.
    PERFORM download_format.






FORM download_format.

  DATA: lt_head TYPE STANDARD TABLE OF string,
        lv_line TYPE string,
        lv_path TYPE string,
        lv_fn   TYPE string,
        lv_dir  TYPE string,
        lv_ok   TYPE i.

  " Column headers in the SAME order as ty_data (tab-separated for xls)
  CONCATENATE
    'Material' 'Description' 'Plant' 'BOM Usage' 'Alt BOM' 'Valid From'
    'Header Text' 'Base Qty' 'Base UoM' 'BOM Status'
    'Item No' 'Component' 'Comp Desc' 'Quantity' 'UoM' 'Item Cat'
    'Doc Change' 'Co-Product' 'Losvn' 'Losbs' 'Sanfe' 'Item Text'
    'Storage Loc' 'Sales Rel' 'Special Proc' 'Net ID'
    'Sort String' 'Alt Usage Prob' 'Alt Strategy' 'Alt Priority' 'Alt Group'
    INTO lv_line SEPARATED BY cl_abap_char_utilities=>horizontal_tab.
  APPEND lv_line TO lt_head.

  cl_gui_frontend_services=>get_desktop_directory( CHANGING desktop_directory = lv_dir ).
  cl_gui_cfw=>flush( ).
  IF lv_dir IS INITIAL.
    lv_dir = 'C:\Temp'.
  ENDIF.
  CONCATENATE lv_dir '\Upload BOM Sample Format.xls' INTO lv_path.

  cl_gui_frontend_services=>gui_download(
    EXPORTING
      filename                = lv_path
      filetype                = 'ASC'
      write_field_separator   = 'X'
    CHANGING
      data_tab                = lt_head
    EXCEPTIONS
      OTHERS                  = 1 ).

  IF sy-subrc = 0.
    MESSAGE 'Format downloaded to Desktop' TYPE 'S'.
  ELSE.
    MESSAGE 'Download failed' TYPE 'S' DISPLAY LIKE 'E'.
  ENDIF.

ENDFORM.













*BOC--Ujwal--04.09.2026 - use system time zone (matches AUFK storage)
    DATA: lv_syszone TYPE ttzz-tzone.

    CALL FUNCTION 'GET_SYSTEM_TIMEZONE'
      IMPORTING
        timezone            = lv_syszone
      EXCEPTIONS
        customizing_missing = 1
        OTHERS              = 2.
    IF sy-subrc <> 0.
      lv_syszone = sy-zonlo.   "fallback
    ENDIF.

    CONVERT TIME STAMP lv_old    TIME ZONE lv_syszone
            INTO DATE lv_old_dat  TIME lv_old_tim.
    CONVERT TIME STAMP curr_time TIME ZONE lv_syszone
            INTO DATE lv_curr_dat TIME lv_curr_tim.
*EOC--Ujwal--04.09.2026







*BOC--Ujwal--03.09.2026.
    DATA: lv_old_dat  TYPE d,
          lv_old_tim  TYPE t,
          lv_curr_dat TYPE d,
          lv_curr_tim TYPE t.

    CONVERT TIME STAMP lv_old    TIME ZONE sy-zonlo
            INTO DATE lv_old_dat  TIME lv_old_tim.

    CONVERT TIME STAMP curr_time TIME ZONE sy-zonlo
            INTO DATE lv_curr_dat TIME lv_curr_tim.
*EOC--Ujwal--03.09.2026.







*--- BOC WHT/INR : sum WT_QBSHH from WITH_ITEM per document ---
  DATA: BEGIN OF ls_wht,
          bukrs   TYPE with_item-bukrs,
          belnr   TYPE with_item-belnr,
          gjahr   TYPE with_item-gjahr,
          wt_qbshh TYPE with_item-wt_qbshh,
        END OF ls_wht.
  DATA: lt_wht LIKE SORTED TABLE OF ls_wht
               WITH UNIQUE KEY bukrs belnr gjahr.

  IF gt_regup IS NOT INITIAL.
    SELECT bukrs, belnr, gjahr, SUM( wt_qbshh ) AS wt_qbshh
      FROM with_item
      FOR ALL ENTRIES IN @gt_regup
      WHERE bukrs = @iv_zbukr
        AND belnr = @gt_regup-belnr
        AND gjahr = @gt_regup-gjahr
      GROUP BY bukrs, belnr, gjahr
      INTO TABLE @lt_wht.
  ENDIF.

*--- write the total back onto each REGUP line ---
  LOOP AT gt_regup INTO ls_regup.
    CLEAR ls_wht.
    READ TABLE lt_wht INTO ls_wht
      WITH KEY bukrs = iv_zbukr
               belnr = ls_regup-belnr
               gjahr = ls_regup-gjahr
      BINARY SEARCH.
    IF sy-subrc = 0.
      ls_regup-wht_sum = ls_wht-wt_qbshh.
    ELSE.
      CLEAR ls_regup-wht_sum.
    ENDIF.
    MODIFY gt_regup FROM ls_regup INDEX sy-tabix
           TRANSPORTING wht_sum.
  ENDLOOP.
*--- EOC WHT/INR ---










  IF gt_regup IS NOT INITIAL.
    SELECT bukrs belnr gjahr wt_qbshh
      FROM with_item
      INTO TABLE lt_wht
      FOR ALL ENTRIES IN gt_regup
      WHERE bukrs = iv_zbukr
        AND belnr = gt_regup-belnr
        AND gjahr = gt_regup-gjahr.
  ENDIF.











  DATA: BEGIN OF ls_wht,
          bukrs    TYPE with_item-bukrs,
          belnr    TYPE with_item-belnr,
          gjahr    TYPE with_item-gjahr,
          wt_qbshh TYPE with_item-wt_qbshh,
        END OF ls_wht.
  DATA: lt_wht LIKE SORTED TABLE OF ls_wht
               WITH NON-UNIQUE KEY bukrs belnr gjahr.

  IF gt_regup IS NOT INITIAL.
    SELECT bukrs belnr gjahr wt_qbshh
      FROM with_item
      INTO TABLE lt_wht
      FOR ALL ENTRIES IN gt_regup
      WHERE bukrs = iv_zbukr
        AND belnr = gt_regup-belnr
        AND gjahr = gt_regup-gjahr.
  ENDIF.

  LOOP AT gt_regup INTO ls_regup.
    CLEAR ls_regup-wht_sum.
    LOOP AT lt_wht INTO ls_wht
         WHERE bukrs = iv_zbukr
           AND belnr = ls_regup-belnr
           AND gjahr = ls_regup-gjahr.
      ls_regup-wht_sum = ls_regup-wht_sum + ls_wht-wt_qbshh.
    ENDLOOP.
    MODIFY gt_regup FROM ls_regup INDEX sy-tabix
           TRANSPORTING wht_sum.
  ENDLOOP.






  DATA: BEGIN OF ls_wht,
          bukrs    TYPE with_item-bukrs,
          belnr    TYPE with_item-belnr,
          gjahr    TYPE with_item-gjahr,
          wt_qbshh TYPE with_item-wt_qbshh,
        END OF ls_wht.
  DATA: lt_wht LIKE SORTED TABLE OF ls_wht
               WITH NON-UNIQUE KEY bukrs belnr gjahr.

  IF gt_regup IS NOT INITIAL.
    SELECT bukrs belnr gjahr wt_qbshh
      FROM with_item
      INTO TABLE lt_wht
      FOR ALL ENTRIES IN gt_regup
      WHERE bukrs = iv_zbukr
        AND belnr = gt_regup-belnr
        AND gjahr = gt_regup-gjahr.
  ENDIF.

  LOOP AT gt_regup INTO ls_regup.
    CLEAR ls_regup-wht_sum.
    LOOP AT lt_wht INTO ls_wht
         WHERE bukrs = iv_zbukr
           AND belnr = ls_regup-belnr
           AND gjahr = ls_regup-gjahr.
      ls_regup-wht_sum = ls_regup-wht_sum + ls_wht-wt_qbshh.
    ENDLOOP.
    MODIFY gt_regup FROM ls_regup INDEX sy-tabix
           TRANSPORTING wht_sum.
  ENDLOOP.
