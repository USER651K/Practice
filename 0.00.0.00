  lv_uom_out   = ls_wt-meins.               "default UoM: WT unit

  IF ls_item-itemno IS NOT INITIAL.
    lv_posnr = ls_item-itemno.              "EWM item -> LIPS-POSNR
    READ TABLE lt_lips_uom INTO ls_lips_uom
      WITH TABLE KEY posnr = lv_posnr.
    IF sy-subrc = 0 AND ls_lips_uom-vgbel IS NOT INITIAL.
      READ TABLE lt_vbap INTO ls_vbap
        WITH TABLE KEY vbeln = ls_lips_uom-vgbel
                       posnr = ls_lips_uom-vgpos.
