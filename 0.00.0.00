is_header-addr_street     = ls_st_adrc-street.
is_header-addr_str_suppl2 = ls_st_adrc-str_suppl2.
is_header-addr_city1      = ls_st_adrc-city1.
is_header-addr_post_code1 = ls_st_adrc-post_code1.
