*BOC--UJWAL--07.10.2026
*--- Shipment Cost Freight = TNDR_MAXP * Delivery Sales / Shipment Sales
        CLEAR: ls_vttk, ls_shp, ls_del.
        READ TABLE gt_vttk INTO ls_vttk
             WITH KEY tknum = ls_vttp-tknum BINARY SEARCH.
        READ TABLE gt_shp_sales INTO ls_shp
             WITH TABLE KEY tknum = ls_vttp-tknum.
        READ TABLE gt_del_sales INTO ls_del
             WITH TABLE KEY tknum = ls_vttp-tknum
                            vbeln = ls_vbfa_j-vbeln.
        IF ls_vttk-tndr_maxp > 0 AND ls_shp-netwr > 0.
          gs_output-ship_cost_frt = ls_vttk-tndr_maxp * ls_del-netwr / ls_shp-netwr.
        ENDIF.
*EOC--UJWAL--07.10.2026
      ENDIF.                                  "<-- KEEP: closes READ gt_vttp
*EOC--CODE ADDED UJWAL--03.07.2026----------  "<-- KEEP










