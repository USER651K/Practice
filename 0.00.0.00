        lv_low      TYPE tvarvc-low,
        lv_high     TYPE tvarvc-high,
        lv_tz_plant TYPE abap_bool,
        lv_mhdhb    TYPE mara-mhdhb.




    IF sy-subrc = 0 AND lv_high IS NOT INITIAL.
    lv_tz_plant = abap_true.
    lv_tgt_tz   = lv_high.







  CONCATENATE 'Confirmed on' lv_date 'at' lv_time 'hrs'
         INTO gv_conf_date SEPARATED BY space.

* Best before date = confirmation date (plant TZ) + total shelf life (days)
  IF lv_tz_plant = abap_true AND ls_caufv-plnbez IS NOT INITIAL.
    SELECT SINGLE mhdhb FROM mara INTO @lv_mhdhb
      WHERE matnr = @ls_caufv-plnbez
        AND iprkz = 'D'.
    IF sy-subrc = 0 AND lv_mhdhb > 0.
      gs_final-vfdat = lv_out_date + lv_mhdhb.
    ENDIF.
  ENDIF.
ENDIF.











    IF sy-subrc = 0 AND lv_mhdhb > 0.
      gs_final-vfdat = lv_out_date + lv_mhdhb.

*     Loop node %EV2 reads GS_FINAL from GT_FINAL1 - update table rows too
      LOOP AT gt_final1 ASSIGNING FIELD-SYMBOL(<ls_final1>)
           WHERE charg = gs_final-charg.
        <ls_final1>-vfdat = gs_final-vfdat.
      ENDLOOP.
      LOOP AT gt_final ASSIGNING FIELD-SYMBOL(<ls_final>)
           WHERE charg = gs_final-charg.
        <ls_final>-vfdat = gs_final-vfdat.
      ENDLOOP.
    ENDIF.










         unit_dim TYPE meabm,
         gross_wt TYPE brgew,     " ADD
         unit_wt  TYPE gewei,     " ADD
       END OF ty_upload.




      gv_meabm_in  TYPE meabm,
      gv_gewei_in  TYPE gewei.    " ADD (move the period: gv_meabm_in now ends with comma)





           gv_matnr_out, gv_meinh_in, gv_meabm_in, gv_gewei_in.





    IF gs_upload-unit_wt IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          input          = gs_upload-unit_wt
          language       = sy-langu
        IMPORTING
          output         = gv_gewei_in
        EXCEPTIONS
          unit_not_found = 1
          OTHERS         = 2.

      IF sy-subrc <> 0.
        PERFORM add_log USING gs_upload-material gs_upload-meinh
                              'E' 'Invalid weight unit'.
        CONTINUE.
      ENDIF.
    ENDIF.








    gs_unitsofmea-unit_dim = gv_meabm_in.
    gs_unitsofmea-gross_wt = gs_upload-gross_wt.      " ADD
    gs_unitsofmea-unit_of_wt = gv_gewei_in.           " ADD
    APPEND gs_unitsofmea TO gt_unitsofmea.





    IF gv_meabm_in IS NOT INITIAL.
      gs_unitsofmex-unit_dim = gc_x.
    ENDIF.
    IF gs_upload-gross_wt IS NOT INITIAL.             " ADD block
      gs_unitsofmex-gross_wt = gc_x.
    ENDIF.
    IF gv_gewei_in IS NOT INITIAL.                    " ADD block
      gs_unitsofmex-unit_of_wt = gc_x.
    ENDIF.
    APPEND gs_unitsofmex TO gt_unitsofmex.
