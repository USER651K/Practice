*BOC-code changes--ujwal--26.10.2026.
* SO item from EWM delivery item reference (REFDOCNO_SO / REFITEMNO_SO)
  CLEAR: ls_vbap, lv_ref_vbeln, lv_ref_posnr.
  IF ls_item-refdocno_so IS NOT INITIAL
     AND ls_item-refitemno_so IS NOT INITIAL.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = ls_item-refdocno_so
      IMPORTING
        output = lv_ref_vbeln.
    lv_ref_posnr = ls_item-refitemno_so.        "0000000030 -> 000030

    READ TABLE lt_vbap INTO ls_vbap
      WITH TABLE KEY vbeln = lv_ref_vbeln
                     posnr = lv_ref_posnr.
    IF sy-subrc = 0 AND ls_vbap-vrkme IS NOT INITIAL.
      IF ls_vbap-vrkme = ls_wt-meins.
*       Same unit as SO - no conversion
        lv_uom_out = ls_vbap-vrkme.
      ELSE.
*       Convert pick qty from WT unit to SO unit
        CLEAR: lv_menge_in, lv_bag_qty.
        lv_menge_in = ls_wt-vsolm.
        CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
          EXPORTING
            i_matnr              = ls_mat_global-matnr
            i_in_me              = ls_wt-meins
            i_out_me             = ls_vbap-vrkme
            i_menge              = lv_menge_in
          IMPORTING
            e_menge              = lv_bag_qty
          EXCEPTIONS
            error_in_application = 1
            error                = 2
            OTHERS               = 3.
        IF sy-subrc = 0.
          lv_qty_sales = lv_bag_qty.
          lv_uom_out   = ls_vbap-vrkme.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
*EOC-code changes--ujwal--26.10.2026.






