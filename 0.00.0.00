        lv_low      TYPE tvarvc-low,
        lv_high     TYPE tvarvc-high,
        lv_tz_plant TYPE abap_bool,
        lv_mhdhb    TYPE mara-mhdhb.




    IF sy-subrc = 0 AND lv_high IS NOT INITIAL.
    lv_tz_plant = abap_true.
    lv_tgt_tz   = lv_high.







  CONCATENATE 'Confirmed on' lv_date 'at' lv_time 'hrs'
         INTO gv_conf_date SEPARATED BY space.

* Best before date = confirmation date (plant TZ) + total shelf life (days)
  IF lv_tz_plant = abap_true AND ls_caufv-plnbez IS NOT INITIAL.
    SELECT SINGLE mhdhb FROM mara INTO @lv_mhdhb
      WHERE matnr = @ls_caufv-plnbez
        AND iprkz = 'D'.
    IF sy-subrc = 0 AND lv_mhdhb > 0.
      gs_final-vfdat = lv_out_date + lv_mhdhb.
    ENDIF.
  ENDIF.
ENDIF.











    IF sy-subrc = 0 AND lv_mhdhb > 0.
      gs_final-vfdat = lv_out_date + lv_mhdhb.

*     Loop node %EV2 reads GS_FINAL from GT_FINAL1 - update table rows too
      LOOP AT gt_final1 ASSIGNING FIELD-SYMBOL(<ls_final1>)
           WHERE charg = gs_final-charg.
        <ls_final1>-vfdat = gs_final-vfdat.
      ENDLOOP.
      LOOP AT gt_final ASSIGNING FIELD-SYMBOL(<ls_final>)
           WHERE charg = gs_final-charg.
        <ls_final>-vfdat = gs_final-vfdat.
      ENDLOOP.
    ENDIF.










         unit_dim TYPE meabm,
         gross_wt TYPE brgew,     " ADD
         unit_wt  TYPE gewei,     " ADD
       END OF ty_upload.




      gv_meabm_in  TYPE meabm,
      gv_gewei_in  TYPE gewei.    " ADD (move the period: gv_meabm_in now ends with comma)





           gv_matnr_out, gv_meinh_in, gv_meabm_in, gv_gewei_in.





    IF gs_upload-unit_wt IS NOT INITIAL.
      CALL FUNCTION 'CONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          input          = gs_upload-unit_wt
          language       = sy-langu
        IMPORTING
          output         = gv_gewei_in
        EXCEPTIONS
          unit_not_found = 1
          OTHERS         = 2.

      IF sy-subrc <> 0.
        PERFORM add_log USING gs_upload-material gs_upload-meinh
                              'E' 'Invalid weight unit'.
        CONTINUE.
      ENDIF.
    ENDIF.








    gs_unitsofmea-unit_dim = gv_meabm_in.
    gs_unitsofmea-gross_wt = gs_upload-gross_wt.      " ADD
    gs_unitsofmea-unit_of_wt = gv_gewei_in.           " ADD
    APPEND gs_unitsofmea TO gt_unitsofmea.





    IF gv_meabm_in IS NOT INITIAL.
      gs_unitsofmex-unit_dim = gc_x.
    ENDIF.
    IF gs_upload-gross_wt IS NOT INITIAL.             " ADD block
      gs_unitsofmex-gross_wt = gc_x.
    ENDIF.
    IF gv_gewei_in IS NOT INITIAL.                    " ADD block
      gs_unitsofmex-unit_of_wt = gc_x.
    ENDIF.
    APPEND gs_unitsofmex TO gt_unitsofmex.













*BOC--UJWAL--07.10.2026 Freight allocation
  TYPES: BEGIN OF ty_del_sales,
           tknum TYPE vttk-tknum,
           vbeln TYPE vttp-vbeln,
           netwr TYPE vbrp-netwr,
         END OF ty_del_sales,
         BEGIN OF ty_shp_sales,
           tknum TYPE vttk-tknum,
           netwr TYPE vbrp-netwr,
         END OF ty_shp_sales.
*EOC--UJWAL--07.10.2026







*BOC--UJWAL--07.10.2026
DATA: gt_del_sales TYPE SORTED TABLE OF ty_del_sales WITH UNIQUE KEY tknum vbeln,
      gt_shp_sales TYPE HASHED TABLE OF ty_shp_sales WITH UNIQUE KEY tknum.
*EOC--UJWAL--07.10.2026




*BOC--UJWAL--07.10.2026 Delivery & shipment-wise invoice value
    CLEAR: gt_del_sales, gt_shp_sales.
    SELECT t~tknum, f~vbelv AS vbeln, SUM( p~netwr ) AS netwr
      FROM vttp AS t
      INNER JOIN vbfa AS f ON  f~vbelv   = t~vbeln
                           AND f~vbtyp_n = 'M'
      INNER JOIN vbrp AS p ON  p~vbeln = f~vbeln
                           AND p~posnr = f~posnn
      INNER JOIN vbrk AS k ON  k~vbeln = p~vbeln
      WHERE t~tknum IN @lr_tknum
        AND k~fksto = @space
      GROUP BY t~tknum, f~vbelv
      INTO CORRESPONDING FIELDS OF TABLE @gt_del_sales.

    DATA ls_shp_coll TYPE ty_shp_sales.
    LOOP AT gt_del_sales INTO DATA(ls_ds).
      ls_shp_coll-tknum = ls_ds-tknum.
      ls_shp_coll-netwr = ls_ds-netwr.
      COLLECT ls_shp_coll INTO gt_shp_sales.
    ENDLOOP.
*EOC--UJWAL--07.10.2026





*BOC--UJWAL--07.10.2026
  DATA: ls_shp TYPE ty_shp_sales,
        ls_del TYPE ty_del_sales.
*EOC--UJWAL--07.10.2026






*BOC--Code Commented--UJWAL--07.10.2026
**--- Calculate SHIPMENT FREIGHT (VTTK)
*        READ TABLE gt_vttk INTO ls_vttk
*          WITH KEY tknum = ls_vttp-tknum.
*        CLEAR lv_deliv_count.
*        LOOP AT gt_vttp INTO DATA(ls_vttp_temp)
*           WHERE tknum = ls_vttp-tknum.
*          lv_deliv_count += 1.
*        ENDLOOP.
*        IF sy-subrc = 0 AND ls_vttk-tndr_maxp IS NOT INITIAL
*                        AND ls_vttk-tndr_maxp > 0.
*          IF lv_deliv_count = 1.
*            gs_output-ship_cost_frt = ls_vttk-tndr_maxp.
*          ELSE.
*            IF lv_tknum_prev <> ls_vttp-tknum.
*              CLEAR lv_total_sales.
*              LOOP AT gt_vbfa_del_m INTO DATA(ls_del_m_loop)
*              WHERE vbelv = ls_vbfa_j-vbeln.
*                READ TABLE gt_vbrk INTO ls_vbrk
*                WITH KEY vbeln = ls_del_m_loop-vbeln
*                BINARY SEARCH.
*                IF sy-subrc = 0.
*                  lv_total_sales = lv_total_sales + ls_vbrk-netwr.
*                ENDIF.
*              ENDLOOP.
*              lv_tknum_prev = ls_vttp-tknum.
*              IF lv_total_sales > 0.
*                lv_shipment_frt = ls_vttk-tndr_maxp / lv_total_sales.
*              ENDIF.
*            ENDIF.
*            gs_output-ship_cost_frt = lv_shipment_frt * gs_output-sales_price.
*          ENDIF.
*        ENDIF.
*EOC--Code Commented--UJWAL--07.10.2026

*BOC--UJWAL--07.10.2026
*--- Shipment Cost Freight = TNDR_MAXP * Delivery Sales / Shipment Sales
        CLEAR: ls_vttk, ls_shp, ls_del.
        READ TABLE gt_vttk INTO ls_vttk
             WITH KEY tknum = ls_vttp-tknum BINARY SEARCH.
        READ TABLE gt_shp_sales INTO ls_shp
             WITH TABLE KEY tknum = ls_vttp-tknum.
        READ TABLE gt_del_sales INTO ls_del
             WITH TABLE KEY tknum = ls_vttp-tknum
                            vbeln = ls_vbfa_j-vbeln.
        IF ls_vttk-tndr_maxp > 0 AND ls_shp-netwr > 0.
          gs_output-ship_cost_frt = ls_vttk-tndr_maxp * ls_del-netwr / ls_shp-netwr.
        ENDIF.
*EOC--UJWAL--07.10.2026
      ENDIF.                                  "<-- KEEP: closes READ gt_vttp
*EOC--CODE ADDED UJWAL--03.07.2026----------  "<-- KEEP














            CLEAR ls_vbrk_bill.
*BOC--UJWAL--08.10.2026  Values from THIS row's billing document
            CLEAR: gs_output-sales_price, gs_output-stwae, gs_output-inco,
                   gs_output-cpg, gs_output-planned_freight, gs_output-cogs.
*EOC--UJWAL--08.10.2026
            READ TABLE gt_vbrk INTO ls_vbrk_bill
              WITH KEY vbeln = ls_del_bill-vbeln.
            IF sy-subrc = 0.
              gs_output-invoice_date = ls_vbrk_bill-fkdat.
*BOC--UJWAL--08.10.2026
              gs_output-sales_price = ls_vbrk_bill-netwr.
              gs_output-stwae       = ls_vbrk_bill-stwae.
              gs_output-inco        = ls_vbrk_bill-inco1.

              LOOP AT gt_prcd INTO ls_prcd WHERE knumv = ls_vbrk_bill-knumv.
                CASE ls_prcd-kschl.
                  WHEN 'ZFRT'.
                    gs_output-planned_freight = gs_output-planned_freight + ls_prcd-kwert.
                  WHEN 'VPRS'.
                    gs_output-cogs = gs_output-cogs + ls_prcd-kwert.
                  WHEN OTHERS.
                    gs_output-cpg = gs_output-cpg + ls_prcd-kwert.
                ENDCASE.
              ENDLOOP.
*EOC--UJWAL--08.10.2026
            ENDIF.









*BOC--UJWAL--08.10.2026  Calculations per billing document row
            DATA: lv_actual_freight TYPE p DECIMALS 2.
            CLEAR: lv_actual_freight, gs_output-net_contribution,
                   gs_output-percent_net, gs_output-plan_frt_var.

            IF gs_output-shipment_freight IS NOT INITIAL.
              lv_actual_freight = gs_output-shipment_freight.
            ELSE.
              lv_actual_freight = gs_output-ship_cost_frt.
            ENDIF.

            gs_output-net_contribution = gs_output-sales_price
                                       - ( lv_actual_freight + gs_output-cogs + gs_output-cpg ).
            IF gs_output-sales_price IS NOT INITIAL.
              gs_output-percent_net = ( gs_output-net_contribution / gs_output-sales_price ) * 100.
            ENDIF.
            gs_output-plan_frt_var = gs_output-planned_freight - lv_actual_freight.
*EOC--UJWAL--08.10.2026













*BOC--CODE ADDED--UJWAL--09.10.2026 - restrict label logic to plant/order type (TVARVC)
  DATA: lv_uk_label TYPE abap_bool,
        lt_uk_var   TYPE STANDARD TABLE OF tvarvc,
        lr_uk_werks TYPE RANGE OF werks_d,
        lr_uk_auart TYPE RANGE OF aufart.

  CLEAR: lv_uk_label, lt_uk_var, lr_uk_werks, lr_uk_auart.

  IF lv_aufnr IS NOT INITIAL.
    SELECT SINGLE werks, auart FROM aufk INTO @DATA(ls_uk_aufk)
      WHERE aufnr = @lv_aufnr.
    IF sy-subrc = 0.
      SELECT * FROM tvarvc INTO TABLE @lt_uk_var
        WHERE name IN ( 'ZPP_UK_LABEL_WERKS', 'ZPP_UK_LABEL_AUART' )
          AND type = 'S'.

      LOOP AT lt_uk_var INTO DATA(ls_uk_var)
           WHERE sign IS NOT INITIAL
             AND opti IS NOT INITIAL.
        CASE ls_uk_var-name.
          WHEN 'ZPP_UK_LABEL_WERKS'.
            APPEND VALUE #( sign   = ls_uk_var-sign
                            option = ls_uk_var-opti
                            low    = ls_uk_var-low
                            high   = ls_uk_var-high ) TO lr_uk_werks.
          WHEN 'ZPP_UK_LABEL_AUART'.
            APPEND VALUE #( sign   = ls_uk_var-sign
                            option = ls_uk_var-opti
                            low    = ls_uk_var-low
                            high   = ls_uk_var-high ) TO lr_uk_auart.
        ENDCASE.
      ENDLOOP.

*     Both lists must have at least one include entry (empty = no match)
      IF line_exists( lr_uk_werks[ sign = 'I' ] ) AND ls_uk_aufk-werks IN lr_uk_werks
     AND line_exists( lr_uk_auart[ sign = 'I' ] ) AND ls_uk_aufk-auart IN lr_uk_auart.
        lv_uk_label = abap_true.
      ENDIF.
    ENDIF.
  ENDIF.
*EOC--CODE ADDED--UJWAL--09.10.2026











*BOC--CODE ADDED--UJWAL--09.10.2026 - restrict label logic to plant/order type (TVARVC)
  DATA: lv_uk_label TYPE abap_bool,
        lv_uk_low   TYPE tvarvc-low,
        lv_uk_high  TYPE tvarvc-high.

  CLEAR: lv_uk_label, lv_uk_low, lv_uk_high.

  IF lv_aufnr IS NOT INITIAL.
    SELECT SINGLE werks, auart FROM aufk INTO @DATA(ls_uk_aufk)
      WHERE aufnr = @lv_aufnr.
    IF sy-subrc = 0.
      lv_uk_low  = ls_uk_aufk-werks.
      lv_uk_high = ls_uk_aufk-auart.
*     TVARVC: LOW = plant, HIGH = order type (one row per combination)
      SELECT SINGLE low FROM tvarvc INTO @DATA(lv_uk_dummy)
        WHERE name = 'ZPP_UK_LABEL_PLNT_AUART'
          AND type = 'S'
          AND sign = 'I'
          AND low  = @lv_uk_low
          AND high = @lv_uk_high.
      IF sy-subrc = 0.
        lv_uk_label = abap_true.
      ENDIF.
    ENDIF.
  ENDIF.
*EOC--CODE ADDED--UJWAL--09.10.2026


