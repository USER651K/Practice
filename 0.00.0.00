*EOC--Code Commented--UJWAL--07.10.2026

*BOC--UJWAL--07.10.2026
*--- Shipment Cost Freight = TNDR_MAXP * Delivery Sales / Shipment Sales
        CLEAR: ls_vttk, ls_shp, ls_del.
        READ TABLE gt_vttk INTO ls_vttk
             WITH KEY tknum = ls_vttp-tknum BINARY SEARCH.
        READ TABLE gt_shp_sales INTO ls_shp
             WITH TABLE KEY tknum = ls_vttp-tknum.
        READ TABLE gt_del_sales INTO ls_del
             WITH TABLE KEY tknum = ls_vttp-tknum
                            vbeln = ls_vbfa_j-vbeln.
        IF ls_vttk-tndr_maxp > 0 AND ls_shp-netwr > 0.
          gs_output-ship_cost_frt = ls_vttk-tndr_maxp * ls_del-netwr / ls_shp-netwr.
        ENDIF.
*EOC--UJWAL--07.10.2026
      ENDIF.                                  "<-- KEEP: closes READ gt_vttp
*EOC--CODE ADDED UJWAL--03.07.2026----------  "<-- KEEP














            CLEAR ls_vbrk_bill.
*BOC--UJWAL--08.10.2026  Values from THIS row's billing document
            CLEAR: gs_output-sales_price, gs_output-stwae, gs_output-inco,
                   gs_output-cpg, gs_output-planned_freight, gs_output-cogs.
*EOC--UJWAL--08.10.2026
            READ TABLE gt_vbrk INTO ls_vbrk_bill
              WITH KEY vbeln = ls_del_bill-vbeln.
            IF sy-subrc = 0.
              gs_output-invoice_date = ls_vbrk_bill-fkdat.
*BOC--UJWAL--08.10.2026
              gs_output-sales_price = ls_vbrk_bill-netwr.
              gs_output-stwae       = ls_vbrk_bill-stwae.
              gs_output-inco        = ls_vbrk_bill-inco1.

              LOOP AT gt_prcd INTO ls_prcd WHERE knumv = ls_vbrk_bill-knumv.
                CASE ls_prcd-kschl.
                  WHEN 'ZFRT'.
                    gs_output-planned_freight = gs_output-planned_freight + ls_prcd-kwert.
                  WHEN 'VPRS'.
                    gs_output-cogs = gs_output-cogs + ls_prcd-kwert.
                  WHEN OTHERS.
                    gs_output-cpg = gs_output-cpg + ls_prcd-kwert.
                ENDCASE.
              ENDLOOP.
*EOC--UJWAL--08.10.2026
            ENDIF.









*BOC--UJWAL--08.10.2026  Calculations per billing document row
            DATA: lv_actual_freight TYPE p DECIMALS 2.
            CLEAR: lv_actual_freight, gs_output-net_contribution,
                   gs_output-percent_net, gs_output-plan_frt_var.

            IF gs_output-shipment_freight IS NOT INITIAL.
              lv_actual_freight = gs_output-shipment_freight.
            ELSE.
              lv_actual_freight = gs_output-ship_cost_frt.
            ENDIF.

            gs_output-net_contribution = gs_output-sales_price
                                       - ( lv_actual_freight + gs_output-cogs + gs_output-cpg ).
            IF gs_output-sales_price IS NOT INITIAL.
              gs_output-percent_net = ( gs_output-net_contribution / gs_output-sales_price ) * 100.
            ENDIF.
            gs_output-plan_frt_var = gs_output-planned_freight - lv_actual_freight.
*EOC--UJWAL--08.10.2026













*BOC--CODE ADDED--UJWAL--09.10.2026 - restrict label logic to plant/order type (TVARVC)
  DATA: lv_uk_label TYPE abap_bool,
        lt_uk_var   TYPE STANDARD TABLE OF tvarvc,
        lr_uk_werks TYPE RANGE OF werks_d,
        lr_uk_auart TYPE RANGE OF aufart.

  CLEAR: lv_uk_label, lt_uk_var, lr_uk_werks, lr_uk_auart.

  IF lv_aufnr IS NOT INITIAL.
    SELECT SINGLE werks, auart FROM aufk INTO @DATA(ls_uk_aufk)
      WHERE aufnr = @lv_aufnr.
    IF sy-subrc = 0.
      SELECT * FROM tvarvc INTO TABLE @lt_uk_var
        WHERE name IN ( 'ZPP_UK_LABEL_WERKS', 'ZPP_UK_LABEL_AUART' )
          AND type = 'S'.

      LOOP AT lt_uk_var INTO DATA(ls_uk_var)
           WHERE sign IS NOT INITIAL
             AND opti IS NOT INITIAL.
        CASE ls_uk_var-name.
          WHEN 'ZPP_UK_LABEL_WERKS'.
            APPEND VALUE #( sign   = ls_uk_var-sign
                            option = ls_uk_var-opti
                            low    = ls_uk_var-low
                            high   = ls_uk_var-high ) TO lr_uk_werks.
          WHEN 'ZPP_UK_LABEL_AUART'.
            APPEND VALUE #( sign   = ls_uk_var-sign
                            option = ls_uk_var-opti
                            low    = ls_uk_var-low
                            high   = ls_uk_var-high ) TO lr_uk_auart.
        ENDCASE.
      ENDLOOP.

*     Both lists must have at least one include entry (empty = no match)
      IF line_exists( lr_uk_werks[ sign = 'I' ] ) AND ls_uk_aufk-werks IN lr_uk_werks
     AND line_exists( lr_uk_auart[ sign = 'I' ] ) AND ls_uk_aufk-auart IN lr_uk_auart.
        lv_uk_label = abap_true.
      ENDIF.
    ENDIF.
  ENDIF.
*EOC--CODE ADDED--UJWAL--09.10.2026











*BOC--CODE ADDED--UJWAL--09.10.2026 - restrict label logic to plant/order type (TVARVC)
  DATA: lv_uk_label TYPE abap_bool,
        lv_uk_low   TYPE tvarvc-low,
        lv_uk_high  TYPE tvarvc-high.

  CLEAR: lv_uk_label, lv_uk_low, lv_uk_high.

  IF lv_aufnr IS NOT INITIAL.
    SELECT SINGLE werks, auart FROM aufk INTO @DATA(ls_uk_aufk)
      WHERE aufnr = @lv_aufnr.
    IF sy-subrc = 0.
      lv_uk_low  = ls_uk_aufk-werks.
      lv_uk_high = ls_uk_aufk-auart.
*     TVARVC: LOW = plant, HIGH = order type (one row per combination)
      SELECT SINGLE low FROM tvarvc INTO @DATA(lv_uk_dummy)
        WHERE name = 'ZPP_UK_LABEL_PLNT_AUART'
          AND type = 'S'
          AND sign = 'I'
          AND low  = @lv_uk_low
          AND high = @lv_uk_high.
      IF sy-subrc = 0.
        lv_uk_label = abap_true.
      ENDIF.
    ENDIF.
  ENDIF.
*EOC--CODE ADDED--UJWAL--09.10.2026











SELECT SINGLE t001~butxt
  FROM ekko
  INNER JOIN t001 ON t001~bukrs = ekko~bukrs
  INTO gv_butxt
  WHERE ekko~ebeln = gs_head-ebeln.













*BOC-----------------------------------------------------------
* Pick sheet exclusion - TVARVC ZEWM_PICK_EXCL
* LOW = plant (LIPS-WERKS), HIGH = PO type (EKKO-BSART)
TYPES: BEGIN OF lty_excl,
         low  TYPE tvarvc-low,
         high TYPE tvarvc-high,
       END OF lty_excl,
       BEGIN OF lty_lips,
         vgbel TYPE lips-vgbel,
         werks TYPE lips-werks,
       END OF lty_lips.

DATA: lt_excl     TYPE STANDARD TABLE OF lty_excl,
      ls_excl     TYPE lty_excl,
      lt_lips     TYPE STANDARD TABLE OF lty_lips,
      ls_lips     TYPE lty_lips,
      lv_bsart    TYPE ekko-bsart,
      lv_dl_vbeln TYPE lips-vbeln.
*EOC-----------------------------------------------------------










*BOC-----------------------------------------------------------
"--- Exclusion: no pick sheet for PO type ZUKL + plant 3050 ---
* TVARVC: LOW = plant, HIGH = PO document type
CLEAR lt_excl.
SELECT low high FROM tvarvc
  INTO TABLE lt_excl
  WHERE name = 'ZEWM_PICK_EXCL'
    AND type = 'S'
    AND sign = 'I'.

IF lt_excl IS NOT INITIAL AND lv_doc_c IS NOT INITIAL.

* Delivery number -> internal format
  CLEAR lv_dl_vbeln.
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = lv_doc_c
    IMPORTING
      output = lv_dl_vbeln.

* LIPS: reference document (PO) and plant per item
  CLEAR lt_lips.
  SELECT vgbel werks FROM lips
    INTO TABLE lt_lips
    WHERE vbeln = lv_dl_vbeln.
  SORT lt_lips BY vgbel werks.
  DELETE ADJACENT DUPLICATES FROM lt_lips COMPARING vgbel werks.

  LOOP AT lt_lips INTO ls_lips.
    IF ls_lips-vgbel IS INITIAL.
      CONTINUE.
    ENDIF.

*   Plant must be maintained in TVARVC-LOW
    READ TABLE lt_excl TRANSPORTING NO FIELDS
      WITH KEY low = ls_lips-werks.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

*   EKKO: PO document type
    CLEAR lv_bsart.
    SELECT SINGLE bsart FROM ekko
      INTO lv_bsart
      WHERE ebeln = ls_lips-vgbel.
    IF sy-subrc <> 0.
      CONTINUE.            "VGBEL is not a PO - not excluded
    ENDIF.

*   Plant (LOW) + PO type (HIGH) pair maintained -> no pick sheet
    READ TABLE lt_excl TRANSPORTING NO FIELDS
      WITH KEY low  = ls_lips-werks
               high = lv_bsart.
    IF sy-subrc = 0.
      RAISE no_data.
    ENDIF.
  ENDLOOP.
ENDIF.
*EOC-----------------------------------------------------------













Thanks for the feedback on the pick sheet. Below is how it currently behaves, what will change, and two points I need you to confirm.

Current behaviour
- Target Qty and UoM are printed in the warehouse task base unit (KG). Example: an SO line of 50 BAG (20 KG/bag) prints as 1000 KG.
- Weight is printed from /SCWM/ORDIM_O-WEIGHT / UNIT_W, as per the field mapping shared by Dharma. This field is the gross (loading) weight, including packaging.

Change 1 – UoM as per SO
As per the mapping shared by Dharma, UoM should come from the delivery item (/SCDL/DB_PROCI_O-UOM), which carries the SO unit. During the build, the warehouse task to delivery item link was not available for HU-based picks, so the base unit was used. That link is now available, and I will change Qty/UoM to print in the SO unit (e.g. 50 BAG).

Please confirm: the pick sheet prints one row per HU/pallet. If one delivery item is picked from more than one HU, should each row show
 a) the quantity to pick from that HU, in the SO unit (e.g. 30 BAG + 20 BAG), or
 b) the total delivery item quantity (50 BAG on each row)?
I recommend option (a), because option (b) would repeat the item total on every row.

Change 2 – Net weight
As this is a change to the weight mapping shared earlier (gross from ORDIM_O), I will calculate net weight as material net weight (MARA-NTGEW) x pick quantity. The footer total will also show net weight. Could you please:
 - confirm this logic,
 - confirm that net weight is maintained in the material master for these materials, and
 - get the FSD weight mapping updated, so that testing matches the build.

Once I have your confirmation, I will complete the change in DEV and share the test print.

Thanks & Regards,















*BOC-code changes--ujwal--15.10.2026.
* Qty/UoM as per SO (VBAP-VRKME) and net weight (MARA-NTGEW)
TYPES: BEGIN OF lty_lips_uom,
         posnr TYPE lips-posnr,
         matnr TYPE lips-matnr,
         meins TYPE lips-meins,
         vgbel TYPE lips-vgbel,
         vgpos TYPE lips-vgpos,
       END OF lty_lips_uom,
       BEGIN OF lty_vbap,
         vbeln TYPE vbap-vbeln,
         posnr TYPE vbap-posnr,
         vrkme TYPE vbap-vrkme,
       END OF lty_vbap,
       BEGIN OF lty_mara,
         matnr TYPE mara-matnr,
         meins TYPE mara-meins,
         ntgew TYPE mara-ntgew,
         gewei TYPE mara-gewei,
       END OF lty_mara.

DATA: lt_lips_uom  TYPE SORTED TABLE OF lty_lips_uom WITH UNIQUE KEY posnr,
      ls_lips_uom  TYPE lty_lips_uom,
      lt_vbap      TYPE SORTED TABLE OF lty_vbap WITH UNIQUE KEY vbeln posnr,
      ls_vbap      TYPE lty_vbap,
      lt_mara      TYPE SORTED TABLE OF lty_mara WITH UNIQUE KEY matnr,
      ls_mara      TYPE lty_mara,
      lv_posnr     TYPE lips-posnr,
      lv_dlv_no    TYPE lips-vbeln,
      lv_qty_sales TYPE p DECIMALS 3,
      lv_uom_out   TYPE meins,
      lv_net_wt    TYPE p DECIMALS 3,
      lv_net_kg    TYPE p DECIMALS 3,
      lv_wgt_unit  TYPE gewei,
      lv_tot_unit  TYPE gewei.
*EOC-code changes--ujwal--15.10.2026.









DATA: lv_who_c           TYPE char20,
*BOC-code changes--ujwal--15.10.2026.
* DECIMALS 3 - avoid rounding of MT total (2.030 vs 2.032)
      lv_total_weight_mt TYPE p DECIMALS 3,
*EOC-code changes--ujwal--15.10.2026.
      lv_doc_c           TYPE char20.






*BOC-code changes--ujwal--15.10.2026.
"--- Delivery items: SO reference, SO unit, net weight basis ----
CLEAR: lt_lips_uom, lt_vbap, lt_mara, lv_dlv_no.
IF lv_doc_c IS NOT INITIAL.
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = lv_doc_c
    IMPORTING
      output = lv_dlv_no.

  SELECT posnr matnr meins vgbel vgpos FROM lips
    INTO CORRESPONDING FIELDS OF TABLE lt_lips_uom
    WHERE vbeln = lv_dlv_no.

  IF lt_lips_uom IS NOT INITIAL.
*   SO unit as per sales order item
    SELECT vbeln posnr vrkme FROM vbap
      INTO CORRESPONDING FIELDS OF TABLE lt_vbap
      FOR ALL ENTRIES IN lt_lips_uom
      WHERE vbeln = lt_lips_uom-vgbel
        AND posnr = lt_lips_uom-vgpos.

*   Net weight per base unit
    SELECT matnr meins ntgew gewei FROM mara
      INTO CORRESPONDING FIELDS OF TABLE lt_mara
      FOR ALL ENTRIES IN lt_lips_uom
      WHERE matnr = lt_lips_uom-matnr.
  ENDIF.
ENDIF.
*EOC-code changes--ujwal--15.10.2026.















DATA: lv_total_weight TYPE p DECIMALS 3.

*BOC-code changes--ujwal--15.10.2026.
CLEAR: lv_total_weight, lv_tot_unit.
*EOC-code changes--ujwal--15.10.2026.









*BOC-code changes--ujwal--15.10.2026.
  CLEAR: ls_lips_uom, ls_vbap, ls_mara, lv_posnr, lv_qty_sales,
         lv_uom_out, lv_net_wt, lv_net_kg, lv_wgt_unit.

  "--- Qty in SO unit (VBAP-VRKME) -------------------------------
  lv_qty_sales = ls_wt-vsolm.               "default: WT unit
  lv_uom_out   = ls_wt-meins.

  IF ls_item-itemno IS NOT INITIAL.
    lv_posnr = ls_item-itemno.              "EWM item -> LIPS-POSNR
    READ TABLE lt_lips_uom INTO ls_lips_uom
      WITH TABLE KEY posnr = lv_posnr.
    IF sy-subrc = 0 AND ls_lips_uom-vgbel IS NOT INITIAL.
      READ TABLE lt_vbap INTO ls_vbap
        WITH TABLE KEY vbeln = ls_lips_uom-vgbel
                       posnr = ls_lips_uom-vgpos.
      IF sy-subrc = 0 AND ls_vbap-vrkme IS NOT INITIAL.
        IF ls_vbap-vrkme = ls_wt-meins.
*         Same unit as SO - no conversion
          lv_uom_out = ls_vbap-vrkme.
        ELSE.
*         Not equal - convert pick qty from WT unit to SO unit
          CLEAR: lv_menge_in, lv_bag_qty.
          lv_menge_in = ls_wt-vsolm.
          CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
            EXPORTING
              i_matnr              = ls_lips_uom-matnr
              i_in_me              = ls_wt-meins
              i_out_me             = ls_vbap-vrkme
              i_menge              = lv_menge_in
            IMPORTING
              e_menge              = lv_bag_qty
            EXCEPTIONS
              error_in_application = 1
              error                = 2
              OTHERS               = 3.
          IF sy-subrc = 0.
            lv_qty_sales = lv_bag_qty.
            lv_uom_out   = ls_vbap-vrkme.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.

  CLEAR lv_qty_c.
  WRITE lv_qty_sales TO lv_qty_c UNIT lv_uom_out
        LEFT-JUSTIFIED NO-GROUPING.
  CONDENSE lv_qty_c NO-GAPS.
  ls_itm-target_qty = lv_qty_c.
  ls_itm-uom        = lv_uom_out.

  "--- Net weight = pick qty (base unit) x MARA-NTGEW ------------
  IF ls_lips_uom-matnr IS NOT INITIAL.
    READ TABLE lt_mara INTO ls_mara
      WITH TABLE KEY matnr = ls_lips_uom-matnr.
  ENDIF.
  IF ls_mara-matnr IS INITIAL AND ls_mat_global-matnr IS NOT INITIAL.
    SELECT SINGLE matnr meins ntgew gewei FROM mara
      INTO CORRESPONDING FIELDS OF ls_mara
      WHERE matnr = ls_mat_global-matnr.
  ENDIF.

  IF ls_mara-ntgew > 0 AND ls_mara-meins = ls_wt-meins.
    lv_net_wt   = ls_wt-vsolm * ls_mara-ntgew.
    lv_wgt_unit = ls_mara-gewei.
  ELSE.
*   Net weight not maintained - fall back to WT loading weight
    lv_net_wt   = ls_wt-weight.
    lv_wgt_unit = ls_wt-unit_w.
  ENDIF.

* Normalise to KG (e.g. NTGEW maintained in TO/MT)
  IF lv_wgt_unit IS NOT INITIAL AND lv_wgt_unit <> 'KG'.
    CALL FUNCTION 'UNIT_CONVERSION_SIMPLE'
      EXPORTING
        input    = lv_net_wt
        unit_in  = lv_wgt_unit
        unit_out = 'KG'
      IMPORTING
        output   = lv_net_kg
      EXCEPTIONS
        OTHERS   = 1.
    IF sy-subrc = 0.
      lv_net_wt   = lv_net_kg.
      lv_wgt_unit = 'KG'.
    ENDIF.
  ENDIF.

  CLEAR: lv_wgt_c, lv_mt_c, lv_wgt_mt.
  WRITE lv_net_wt TO lv_wgt_c LEFT-JUSTIFIED NO-GROUPING DECIMALS 0.
  CONDENSE lv_wgt_c NO-GAPS.

  IF lv_wgt_unit = 'KG'.
    lv_wgt_mt = lv_net_wt / 1000.
    WRITE lv_wgt_mt TO lv_mt_c LEFT-JUSTIFIED NO-GROUPING DECIMALS 3.
    CONDENSE lv_mt_c NO-GAPS.
    CONCATENATE lv_wgt_c lv_wgt_unit '(' lv_mt_c 'MT)'
      INTO ls_itm-weight SEPARATED BY space.
    lv_total_weight_mt = lv_total_weight_mt + lv_wgt_mt.
  ELSE.
    CONCATENATE lv_wgt_c lv_wgt_unit
      INTO ls_itm-weight SEPARATED BY space.
  ENDIF.

  lv_total_weight = lv_total_weight + lv_net_wt.
  lv_tot_unit     = lv_wgt_unit.
*EOC-code changes--ujwal--15.10.2026.










IF lv_total_weight_mt > 0.
  WRITE lv_total_weight_mt TO lv_mt_c LEFT-JUSTIFIED NO-GROUPING DECIMALS 3.
  CONDENSE lv_mt_c NO-GAPS.
*BOC-code changes--ujwal--15.10.2026.
  CONCATENATE lv_wgt_c lv_tot_unit '(' lv_mt_c 'MT)'
    INTO lv_tot_weight SEPARATED BY space.
ELSE.
  CONCATENATE lv_wgt_c lv_tot_unit INTO lv_tot_weight SEPARATED BY space.
*EOC-code changes--ujwal--15.10.2026.
ENDIF.









  "--- Qty as per WT (VSOLM), UoM as per SO (VBAP-VRKME) --------
*BOC-code changes--ujwal--15.10.2026.
